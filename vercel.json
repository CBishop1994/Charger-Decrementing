{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/procurement-close",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/consumables-alerts",
      "schedule": "0 15 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/inventory?resource=health"
    },
    {
      "source": "/api/dashboard",
      "destination": "/api/inventory?resource=dashboard"
    },
    {
      "source": "/api/seed",
      "destination": "/api/inventory?resource=seed"
    },
    {
      "source": "/api/print",
      "destination": "/api/inventory?resource=print"
    },
    {
      "source": "/api/scan",
      "destination": "/api/inventory?resource=scan"
    },
    {
      "source": "/api/transactions",
      "destination": "/api/inventory?resource=transactions"
    },
    {
      "source": "/api/consumables/:id/adjust",
      "destination": "/api/inventory?resource=consumables&id=:id&action=adjust"
    },
    {
      "source": "/api/consumables/:id",
      "destination": "/api/inventory?resource=consumables&id=:id"
    },
    {
      "source": "/api/consumables",
      "destination": "/api/inventory?resource=consumables"
    },
    {
      "source": "/api/stock-orders/:id/deliver",
      "destination": "/api/inventory?resource=stock-orders&id=:id&action=deliver"
    },
    {
      "source": "/api/stock-orders/:id/cancel",
      "destination": "/api/inventory?resource=stock-orders&id=:id&action=cancel"
    },
    {
      "source": "/api/stock-orders/:id",
      "destination": "/api/inventory?resource=stock-orders&id=:id"
    },
    {
      "source": "/api/stock-orders",
      "destination": "/api/inventory?resource=stock-orders"
    },
    {
      "source": "/api/bin-locations/:id",
      "destination": "/api/inventory?resource=bin-locations&id=:id"
    },
    {
      "source": "/api/bin-locations",
      "destination": "/api/inventory?resource=bin-locations"
    },
    {
      "source": "/api/printers/:id",
      "destination": "/api/inventory?resource=printers&id=:id"
    },
    {
      "source": "/api/printers",
      "destination": "/api/inventory?resource=printers"
    },
    {
      "source": "/api/approved-emails/:id",
      "destination": "/api/inventory?resource=approved-emails&id=:id"
    },
    {
      "source": "/api/approved-emails",
      "destination": "/api/inventory?resource=approved-emails"
    },
    {
      "source": "/api/consumables-alerts/run",
      "destination": "/api/inventory?resource=consumables-alerts&action=run"
    },
    {
      "source": "/api/consumables-alerts/settings",
      "destination": "/api/inventory?resource=consumables-alerts&action=settings"
    },
    {
      "source": "/api/consumables-alerts/status",
      "destination": "/api/inventory?resource=consumables-alerts&action=status"
    },
    {
      "source": "/api/consumables-alerts",
      "destination": "/api/inventory?resource=consumables-alerts&action=status"
    },
    {
      "source": "/api/procurement/close",
      "destination": "/api/inventory?resource=procurement&action=close"
    },
    {
      "source": "/api/procurement/settings",
      "destination": "/api/inventory?resource=procurement&action=settings"
    },
    {
      "source": "/api/procurement/status",
      "destination": "/api/inventory?resource=procurement&action=status"
    },
    {
      "source": "/api/procurement/:id",
      "destination": "/api/inventory?resource=procurement&id=:id"
    },
    {
      "source": "/api/procurement",
      "destination": "/api/inventory?resource=procurement"
    },
    {
      "source": "/api/integrations/test",
      "destination": "/api/inventory?resource=integrations&action=test"
    },
    {
      "source": "/api/integrations/status",
      "destination": "/api/inventory?resource=integrations&action=status"
    },
    {
      "source": "/api/integrations",
      "destination": "/api/inventory?resource=integrations&action=status"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
